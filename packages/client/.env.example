# Base URL of the Socket.IO server. Leave unset (empty) for both local dev
# (Vite proxies /socket.io to localhost:4000 — see vite.config.ts) and for a
# single full-stack production deploy where the client is served BY the same
# server (same-origin, so an empty string resolves correctly).
# VITE_SERVER_URL=https://your-deployed-app.example.com
