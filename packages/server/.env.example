# Port the Express + Socket.IO server listens on.
PORT=4000

# Origin the browser client is served from. In local dev this is Vite's dev
# server; in a single full-stack production deploy, set this to your public
# deployed URL (the server also serves the client's static build itself, so
# same-origin requests won't even need CORS — this is a safety net).
CLIENT_ORIGIN=http://localhost:5173

# Optional override for where the built client's static files live. Defaults
# to ../client/dist relative to the server's source directory, which is
# correct for the monorepo layout as-is — only set this if you restructure
# the deploy (e.g. copying the client build to a different path).
# CLIENT_DIST_PATH=/app/packages/client/dist
